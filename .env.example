# ==============================================================================
# The Lenny Growth Assistant - Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Database Persistence (PostgreSQL with pgvector)
# For local Docker Compose:
DATABASE_URL=postgresql+asyncpg://postgres:password123@localhost:5432/lenny_assistant
# Note: If PostgreSQL is offline, the app automatically falls back to an embedded SQLite database.

# Local LLM Provider (Ollama - Mandatory for Local Demo)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Alternatives: llama3.1:8b, mistral:7b, qwen2.5:3b

# Cloud LLM Providers (Optional Toggles)
# Set your API keys to enable seamless switching in the top navbar
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Default Runtime Provider ("ollama", "claude", or "openai")
DEFAULT_PROVIDER=ollama

# Retrieval Hyperparameters
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.60
EMBEDDING_DIMENSION=384

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
