# ==============================================================================
# AI Study Companion - Environment Configuration
# ==============================================================================

# Environment Mode: development | staging | production
ENVIRONMENT=development
PROJECT_NAME="AI Study Companion"
API_V1_STR="/api/v1"

# Database Connection (PostgreSQL 16 with pgvector)
# For Docker Compose: postgresql+asyncpg://postgres:password123@db:5432/study_companion
# For Local Run:     postgresql+asyncpg://postgres:password123@localhost:5432/study_companion
DB_URL=postgresql+asyncpg://postgres:password123@localhost:5432/study_companion
DATABASE_URL=postgresql+asyncpg://postgres:password123@localhost:5432/study_companion
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./study_companion.db

# Redis Connection (Job queue and caching)
# For Docker Compose: redis://redis:6379/0
# For Local Run:     redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET=dev-secret-key-change-in-production-12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
DEFAULT_PROVIDER=openai

# Local Ollama Fallback (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Storage Path for Uploaded Learning Materials (PDFs)
STORAGE_PATH=./storage/materials

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
